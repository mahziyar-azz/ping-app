<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PingApp.ViewModels"
        x:Class="PingApp.Views.HistoryWindow"
        x:DataType="vm:HistoryViewModel"
        Title="IP Check History - Iranian Internet Monitor"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        Icon="avares://PingApp/Assets/icon.ico">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <!-- Top Controls: Search and Actions -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     PlaceholderText="Filter by IP, Country, or Time..."
                     Text="{Binding SearchFilter}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Margin="0,0,8,0"
                    Padding="12,6"/>

            <Button Grid.Column="2"
                    Content="Clear History"
                    Command="{Binding ClearHistoryCommand}"
                    Padding="12,6"/>
        </Grid>

        <!-- Main DataGrid -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid ItemsSource="{Binding DisplayRecords}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding Id}"
                                        Width="60"/>
                    <DataGridTextColumn Header="IP Address"
                                        Binding="{Binding Ip}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Country"
                                        Binding="{Binding Country}"
                                        Width="140"/>
                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding Time}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer / Status -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding DisplayRecords.Count, StringFormat='Showing {0} records (maximum 100 retained)'}"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
